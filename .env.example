# Copy to .env (repo root) and fill in what you use.

# ElevenLabs — required for voice (tools/gen_voice.py); also powers
# sound-effect generation (tools/gen_sfx.py) and music beds (tools/gen_music.py).
ELEVENLABS_API_KEY=

# Google Gemini — image generation (tools/gen_image.py), e.g. story frames.
GEMINI_API_KEY=

# fal.ai — optional, generative video clips (tools/gen_clip.py).
FAL_KEY=

# Fish Audio — automatic TTS fallback for tools/gen_voice.py when ElevenLabs fails
# (e.g. billing issue). Optional --fish-voice reference_id picks a specific voice.
FISHAUDIO_API_KEY=
